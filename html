<title>Lucky Lounge – Spielcasino</title>
<style>
:root{--bg:#0b1020;--panel:#151d32;--panel2:#1b2740;--gold:#f5c451;--green:#25c58a;--muted:#9eabc3;--red:#f06b75}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at top,#182747 0,#0b1020 55%);color:#f4f6fb;font-family:system-ui,-apple-system,Segoe UI,sans-serif;min-height:100vh}
header{padding:22px max(18px,calc((100% - 1180px)/2));display:flex;align-items:center;justify-content:space-between;gap:16px;border-bottom:1px solid #ffffff14;background:#0b1020cc;position:sticky;top:0;z-index:5;backdrop-filter:blur(12px)}
.brand{font-weight:900;font-size:22px;letter-spacing:.4px}.brand span{color:var(--gold)}.balance{background:#202b43;border:1px solid #ffffff20;border-radius:14px;padding:10px 15px;font-weight:800;color:var(--gold)}
main{max-width:1180px;margin:auto;padding:26px 18px 60px}.hero{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:22px}.eyebrow{color:var(--green);font-size:12px;font-weight:800;letter-spacing:1.8px;text-transform:uppercase}.hero h1{font-size:clamp(28px,5vw,44px);margin:5px 0}.hero p{color:var(--muted);margin:0;max-width:650px;line-height:1.5}
.notice{font-size:12px;color:#b7c2d6;background:#ffffff09;border:1px solid #ffffff18;border-radius:12px;padding:10px 13px;max-width:230px}
.layout{display:grid;grid-template-columns:245px 1fr;gap:18px}.sidebar,.game-area{background:#111a2d;border:1px solid #ffffff14;border-radius:18px;padding:15px}.side-title{font-size:12px;color:var(--muted);font-weight:800;text-transform:uppercase;letter-spacing:1.2px;margin:4px 8px 12px}
.game-list{display:grid;gap:6px}.game-btn{width:100%;text-align:left;background:transparent;color:#dce4f3;border:0;border-radius:11px;padding:11px 12px;cursor:pointer;font:inherit;display:flex;gap:10px;align-items:center}.game-btn:hover,.game-btn.active{background:#263451;color:white}.game-btn.active{outline:1px solid #f5c45166}.game-icon{width:28px;text-align:center;font-size:19px}
.game-area{min-height:510px;padding:22px}.game-head{display:flex;justify-content:space-between;align-items:start;gap:12px;margin-bottom:18px}.game-head h2{margin:0 0 4px;font-size:25px}.game-head p{margin:0;color:var(--muted);font-size:14px}.tag{font-size:11px;color:var(--gold);border:1px solid #f5c45155;padding:5px 8px;border-radius:20px;white-space:nowrap}
.playbox{background:linear-gradient(145deg,#1b2944,#121c30);border:1px solid #ffffff14;border-radius:16px;padding:22px;min-height:300px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}
.big-result{font-size:clamp(36px,7vw,62px);font-weight:900;letter-spacing:2px;margin:10px 0 18px;color:var(--gold);min-height:75px;display:flex;align-items:center;justify-content:center;gap:12px;flex-wrap:wrap}
.controls{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;align-items:center;margin-top:12px}
input,select{background:#0e1729;color:white;border:1px solid #ffffff30;border-radius:10px;padding:11px 12px;font:inherit;min-width:100px}
button.primary,button.secondary{border:0;border-radius:11px;padding:11px 18px;font:inherit;font-weight:800;cursor:pointer}
.primary{background:var(--gold);color:#1a1b20}.primary:hover{filter:brightness(1.08)}.secondary{background:#30415f;color:white}.secondary:hover{background:#3b5278}
button:disabled{opacity:.45;cursor:not-allowed}.message{min-height:26px;margin-top:15px;color:#c9d5e9;font-weight:650}.good{color:var(--green)!important}.bad{color:var(--red)!important}
.small{font-size:12px;color:var(--muted);margin-top:10px}.cards{display:flex;gap:8px;justify-content:center;flex-wrap:wrap}.playing-card{width:58px;height:82px;background:#f6f4ee;color:#182033;border-radius:8px;display:grid;place-items:center;font-size:22px;font-weight:900;box-shadow:0 4px 12px #0005}.playing-card.red{color:#d33d4e}
.grid-mines{display:grid;grid-template-columns:repeat(5,48px);gap:7px}.mine-cell{width:48px;height:48px;border:1px solid #ffffff25;border-radius:9px;background:#30415f;color:white;font-size:20px;cursor:pointer}.mine-cell.revealed{background:#1d765c}.mine-cell.mine{background:#a83b4a}
.history{margin-top:15px;color:var(--muted);font-size:12px}
.table-stage{width:min(100%,520px);margin:8px auto 14px;position:relative}
.table-stage canvas{display:block;width:100%;height:auto;border-radius:14px}
.roulette-stage{background:radial-gradient(ellipse,#17684e,#0b352b 70%);border:7px solid #8a622c;border-radius:18px;padding:10px;box-shadow:inset 0 0 24px #0008,0 12px 28px #0005}
.roulette-stage canvas{max-width:440px;margin:auto}
.ball-note{font-size:12px;color:#d9e5d8;margin-top:4px}
.card-row{display:flex;justify-content:center;gap:10px;min-height:94px;flex-wrap:wrap;perspective:700px}
.deal-card{width:62px;height:88px;position:relative;transform-style:preserve-3d;animation:dealCard .65s cubic-bezier(.2,.8,.2,1) both}
.deal-card .face{position:absolute;inset:0;border-radius:9px;display:grid;place-items:center;background:#faf8f0;color:#172033;border:2px solid #fff;box-shadow:0 5px 12px #0006;font-size:22px;font-weight:900;backface-visibility:hidden}
.deal-card .back{background:repeating-linear-gradient(45deg,#263f68,#263f68 6px,#e1c36b 7px,#263f68 9px);border:4px solid #f8f0d5;transition:transform .55s ease}
.deal-card .front{transform:rotateY(180deg);transition:transform .55s ease}
.deal-card.flipped .back{transform:rotateY(180deg)}
.deal-card.flipped .front{transform:rotateY(0)}
.deal-card .front{transform:none!important;backface-visibility:visible!important;transition:none!important}
.deal-card .back{transform:none!important;backface-visibility:visible!important;transition:none!important}
.card-face-inner{width:100%;height:100%;position:relative;display:grid;place-items:center}
.card-corner{position:absolute;top:4px;left:6px;font-size:15px;line-height:1.05;text-align:center}
.card-suit{font-size:31px;line-height:1}
@keyframes dealCard{0%{opacity:0;transform:translate(120px,-90px) rotate(24deg) rotateY(180deg) scale(.7)}100%{opacity:1;transform:translate(0,0) rotate(0) rotateY(0) scale(1)}}
.dice-stage{width:120px;height:120px;display:grid;place-items:center;perspective:500px;margin:12px auto}
.dice-cube{font-size:86px;filter:drop-shadow(0 12px 7px #0008);transform-style:preserve-3d}
.dice-cube.rolling{animation:diceRoll 1.25s cubic-bezier(.15,.7,.2,1)}
@keyframes diceRoll{0%{transform:rotateX(0) rotateY(0) rotateZ(0) scale(.85)}35%{transform:rotateX(420deg) rotateY(300deg) rotateZ(160deg) scale(1.15)}70%{transform:rotateX(850deg) rotateY(720deg) rotateZ(330deg) scale(1.05)}100%{transform:rotateX(1080deg) rotateY(1080deg) rotateZ(360deg) scale(1)}}
.coin-stage{width:124px;height:124px;margin:8px auto;perspective:600px;display:grid;place-items:center}
.coin-disc{width:100px;height:100px;border-radius:50%;border:7px double #9b6c20;background:radial-gradient(circle at 30% 25%,#fff0a6,#d79a26 55%,#865319);display:grid;place-items:center;color:#59360d;font-size:36px;font-weight:1000;box-shadow:0 12px 18px #0007;transform-style:preserve-3d}
.coin-disc.flipping{animation:coinFlip 1.4s cubic-bezier(.2,.75,.2,1)}
@keyframes coinFlip{0%{transform:translateY(0) rotateY(0) rotateX(0)}25%{transform:translateY(-75px) rotateY(540deg) rotateX(180deg)}55%{transform:translateY(-25px) rotateY(1260deg) rotateX(360deg)}80%{transform:translateY(4px) rotateY(1800deg) rotateX(540deg)}100%{transform:translateY(0) rotateY(1980deg) rotateX(720deg)}}
.plinko-stage{background:linear-gradient(#15253c,#0d1728);border:1px solid #ffffff22;border-radius:16px;overflow:hidden}
.plinko-caption{font-size:12px;color:#c6d1e3;margin:0 0 5px}

.secret-box{margin-top:15px;padding:12px;background:#1a263d;border:1px solid #f5c45144;border-radius:12px;text-align:center}
.secret-box input{width:120px;text-align:center;margin-bottom:8px}

@keyframes popIn{0%{transform:scale(.72) rotate(-5deg);opacity:.25}70%{transform:scale(1.08)}100%{transform:scale(1);opacity:1}}
@keyframes shimmer{0%{filter:brightness(.8);transform:translateY(0)}50%{filter:brightness(1.55);transform:translateY(-5px)}100%{filter:brightness(1);transform:translateY(0)}}
@keyframes spin{0%{transform:rotate(0) scale(.8)}65%{transform:rotate(760deg) scale(1.08)}100%{transform:rotate(1080deg) scale(1)}}
@keyframes shake{0%,100%{transform:translateX(0)}20%,60%{transform:translateX(-7px)}40%,80%{transform:translateX(7px)}}
@keyframes glow{0%,100%{box-shadow:0 0 0 #f5c45100}50%{box-shadow:0 0 26px #f5c45155}}
.big-result.animate{animation:popIn .48s cubic-bezier(.2,.8,.2,1)}
.big-result.spinning{animation:spin 1.05s cubic-bezier(.15,.7,.15,1)}
.big-result.win{animation:shimmer .7s ease 2;color:#ffe28a}
.big-result.lose{animation:shake .42s ease;color:var(--red)}
.playing-card{animation:popIn .35s ease both}
.mine-cell{transition:transform .16s ease,background .2s ease,box-shadow .2s ease}
.mine-cell:not(:disabled):hover{transform:translateY(-3px) scale(1.06);box-shadow:0 7px 18px #0006}
.mine-cell.revealed{animation:popIn .25s ease;background:#1d765c}
.mine-cell.mine{animation:shake .4s ease;background:#a83b4a}
.primary{transition:transform .15s ease,filter .15s ease,box-shadow .15s ease}
.primary:not(:disabled):hover{transform:translateY(-2px);box-shadow:0 7px 20px #f5c45135}
.primary:not(:disabled):active{transform:scale(.97)}.footer{text-align:center;color:#7887a2;font-size:12px;margin-top:22px}
@media(max-width:760px){header{padding:15px 18px}.layout{grid-template-columns:1fr}.sidebar{padding:12px}.game-list{display:flex;overflow-x:auto;padding-bottom:3px}.game-btn{width:auto;white-space:nowrap}.side-title{display:none}.hero{align-items:start;flex-direction:column}.notice{max-width:none}.game-area{padding:15px}.playbox{padding:16px}.grid-mines{grid-template-columns:repeat(5, min(48px,14vw));gap:5px}.mine-cell{width:min(48px,14vw);height:min(48px,14vw)}}
</style>
</head>
<body>
<header><div class="brand">🎰 LUCKY <span>LOUNGE</span></div><div class="balance">🪙 <span id="balance">1.000</span> Spielmünzen</div></header>
<main>
<section class="hero"><div><div class="eyebrow">Dein virtuelles Spielcasino</div><h1>Willkommen in der Lucky Lounge</h1><p>Wähle eines von zehn Spielen, setze Spielmünzen und probiere dein Glück. Ganz ohne echtes Geld.</p></div><div class="notice">ℹ️ Nur Spielgeld – keine Einzahlungen, Auszahlungen oder Echtgeldpreise.</div></section>
<div class="layout">
<aside class="sidebar">
  <div class="side-title">Spiele entdecken</div>
  <nav class="game-list" id="gameList"></nav>
  <div class="history" id="stats">Runden: 0 · Gewinn: 0</div>
  <button class="secondary" style="width:100%;margin-top:14px" onclick="resetBalance()">↻ Spielstand zurücksetzen</button>
  
  <!-- Code Feld für Give Money Portal -->
  <div class="secret-box">
    <div style="font-size:11px;color:var(--muted);margin-bottom:6px">Code-Eingabe:</div>
    <input type="password" id="secretCodeInput" placeholder="Code..." oninput="checkCode()">
    <div id="giveMoneyPortal" style="display:none;margin-top:8px;">
      <div style="font-size:12px;color:var(--gold);font-weight:bold;margin-bottom:6px">💰 Give Money Portal</div>
      <input type="number" id="portalAmount" placeholder="Summe" min="1" style="width:100px;">
      <button class="primary" style="padding:6px 10px;font-size:12px;margin-top:4px;" onclick="claimPortalMoney()">Guthaben aufladen</button>
    </div>
  </div>
</aside>
<section class="game-area"><div class="game-head"><div><h2 id="gameTitle">🎰 Spielautomaten</h2><p id="gameDesc">Drei Walzen, ein Einsatz und hoffentlich ein Treffer.</p></div><span class="tag">NUR SPIELGELD</span></div><div class="playbox" id="playbox"></div></section>
</div><div class="footer">Lucky Lounge · Spielgeld-Casino · Dein Spielstand wird auf diesem Gerät gespeichert.</div>
</main>
<script>
const games=[
 {id:'slots',name:'Spielautomat',icon:'🎰',desc:'Drei gleiche Symbole bringen den großen Gewinn.'},
 {id:'roulette',name:'Roulette',icon:'🎡',desc:'Wähle eine Zahl oder eine Farbe und lass die Kugel rollen.'},
 {id:'blackjack',name:'Blackjack',icon:'🃏',desc:'Komme möglichst nah an 21, ohne sie zu überschreiten.'},
 {id:'dice',name:'Würfel-Duell',icon:'🎲',desc:'Tippe, ob der Würfel höher oder niedriger als 3 landet.'},
 {id:'coin',name:'Münzwurf',icon:'🪙',desc:'Kopf oder Zahl – einfach und schnell.'},
 {id:'hilo',name:'Höher oder tiefer',icon:'📈',desc:'Schätze, ob die nächste Karte höher oder niedriger ist.'},
 {id:'mines',name:'Minenfeld',icon:'💣',desc:'Finde sichere Felder und kassiere deinen wachsenden Gewinn.'},
 {id:'wheel',name:'Glücksrad',icon:'🎯',desc:'Drehe das Rad und gewinne einen Multiplikator.'},
 {id:'baccarat',name:'Punkteduell',icon:'⚔️',desc:'Deine Karte gegen die Bank – wer kommt näher an 9?' },
 {id:'plinko',name:'Plinko',icon:'🔴',desc:'Lass die Kugel fallen und hoffe auf einen guten Multiplikator.'}
];
let balance=Number(localStorage.getItem('ll_balance')||1000), rounds=0, net=0, current='slots';
let blackjack=null,hiloCard=null,mines=null;
const $=id=>document.getElementById(id);
function save(){localStorage.setItem('ll_balance',balance);$('balance').textContent=balance.toLocaleString('de-DE');$('stats').textContent=`Runden: ${rounds} · Netto: ${net>0?'+':''}${net.toLocaleString('de-DE')}`;}
function betInput(value=20){return `<label>Einsatz <input id="bet" type="number" min="1" max="${balance}" value="${Math.min(value,Math.max(1,balance))}" step="1"></label>`}
function bet(){let n=Number($('bet')?.value);if(!Number.isInteger(n)||n<1||n>balance){msg('Bitte einen gültigen Einsatz eingeben.','bad');return null}return n}
function msg(t,c=''){let e=$('message');if(e){e.textContent=t;e.className='message '+c}}
function animateResult(kind='animate'){let e=$('playbox')?.querySelector('.big-result');if(!e)return;e.classList.remove('animate','spinning','win','lose');void e.offsetWidth;e.classList.add(kind)}
function settle(stake,payout){balance+=payout-stake;net+=payout-stake;rounds++;save();return payout-stake}
function shell(content){$('playbox').innerHTML=content}
function selectGame(id){current=id;let g=games.find(x=>x.id===id);$('gameTitle').textContent=g.icon+' '+g.name;$('gameDesc').textContent=g.desc;document.querySelectorAll('.game-btn').forEach(b=>b.classList.toggle('active',b.dataset.id===id));render()}
function render(){let f={slots:slots,roulette:roulette,blackjack:bj,dice:dice,coin:coin,hilo:hilo,mines:minesGame,wheel:wheel,baccarat:baccarat,plinko:plinko};f[current]()}

function checkCode(){
  if($('secretCodeInput').value === '121314'){
    $('giveMoneyPortal').style.display = 'block';
  } else {
    $('giveMoneyPortal').style.display = 'none';
  }
}

function claimPortalMoney(){
  let amt = Number($('portalAmount').value);
  if(amt > 0){
    balance += amt;
    save();
    alert(amt.toLocaleString('de-DE') + ' Münzen hinzugefügt!');
    $('portalAmount').value = '';
  }
}

function slots(){shell(`${betInput()}<div class="big-result" id="slotResult">🍒　⭐　💎</div><div class="controls"><button class="primary" onclick="spinSlots()">DREHEN</button></div><div class="message" id="message">Drei gleiche Symbole zahlen das 5-Fache aus. Drei 💎 zahlen das 12-Fache!</div>`)}
function spinSlots(){let b=bet();if(!b)return;animateResult('spinning');let a=['🍒','🍋','🔔','⭐','💎','🍀'],r=Array.from({length:3},()=>a[Math.floor(Math.random()*a.length)]);$('slotResult').textContent=r.join('　');let mult=r.every(x=>x===r[0])?(r[0]==='💎'?12:5):r.filter(x=>x===r[0]).length===2?1.5:0;let p=Math.floor(b*mult);let d=settle(b,p);animateResult(p?'win':'lose');msg(p?`Treffer! ${p} Münzen Auszahlung · ${d>0?'+':''}${d} netto.`:'Leider kein Treffer. Versuch es erneut.',p?'good':'bad')}
const rouletteOrder=[0,32,15,19,4,21,2,25,17,34,6,27,13,36,11,30,8,23,10,5,24,16,33,1,20,14,31,9,22,18,29,7,28,12,35,3,26];
function rouletteColor(n){return n===0?'#13834f':([1,3,5,7,9,12,14,16,18,19,21,23,25,27,30,32,34,36].includes(n)?'#c52e3c':'#171a20')}
function drawRoulette(ballAngle=null,ballRadius=145){let c=$('rouletteCanvas');if(!c)return;let ctx=c.getContext('2d'),cx=220,cy=220;ctx.clearRect(0,0,440,440);let g=ctx.createRadialGradient(cx,cy,30,cx,cy,210);g.addColorStop(0,'#d7a84b');g.addColorStop(.45,'#6b451d');g.addColorStop(1,'#2d1b0d');ctx.fillStyle=g;ctx.beginPath();ctx.arc(cx,cy,211,0,Math.PI*2);ctx.fill();ctx.fillStyle='#1b271d';ctx.beginPath();ctx.arc(cx,cy,187,0,Math.PI*2);ctx.fill();
let step=Math.PI*2/37;rouletteOrder.forEach((n,i)=>{let st=-Math.PI/2+i*step,en=st+step;ctx.beginPath();ctx.moveTo(cx,cy);ctx.arc(cx,cy,174,st,en);ctx.closePath();ctx.fillStyle=rouletteColor(n);ctx.fill();ctx.strokeStyle='#d6b36a';ctx.lineWidth=1;ctx.stroke();let mid=st+step/2;ctx.save();ctx.translate(cx+Math.cos(mid)*155,cy+Math.sin(mid)*155);ctx.rotate(mid+Math.PI/2);ctx.fillStyle='#fff3ce';ctx.font='bold 12px system-ui';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(n,0,0);ctx.restore()});
ctx.fillStyle='#d5aa53';ctx.beginPath();ctx.arc(cx,cy,57,0,Math.PI*2);ctx.fill();ctx.fillStyle='#68451b';ctx.beginPath();ctx.arc(cx,cy,46,0,Math.PI*2);ctx.fill();ctx.fillStyle='#f6d88d';ctx.font='bold 17px system-ui';ctx.textAlign='center';ctx.fillText('LUCKY',cx,cy+6);
if(ballAngle!==null){let x=cx+Math.cos(ballAngle)*ballRadius,y=cy+Math.sin(ballAngle)*ballRadius;ctx.shadowColor='#fff';ctx.shadowBlur=13;ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(x,y,8,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0;ctx.strokeStyle='#c9c9c9';ctx.lineWidth=2;ctx.stroke()}}
function roulette(){shell(`${betInput()}<div class="controls"><label>Dein Tipp <select id="rt"><option value="red">Rot</option><option value="black">Schwarz</option><option value="green">Grün (0)</option><option value="number">Exakte Zahl</option></select></label><input id="rn" type="number" min="0" max="36" value="17" style="display:none"></div><div class="table-stage roulette-stage"><canvas id="rouletteCanvas" width="440" height="440"></canvas></div><div class="ball-note">Die weiße Kugel kreist über dem echten Zahlenrad und rollt in ein Fach.</div><button class="primary" id="rouletteSpin" onclick="spinRoulette()">KUGEL STARTEN</button><div class="message" id="message">Rot/Schwarz: 2× · Grün: 14× · Zahl exakt: 30× Auszahlung.</div>`);$('rt').onchange=()=>{$('rn').style.display=$('rt').value==='number'?'block':'none'};drawRoulette()}
function spinRoulette(){let b=bet();if(!b)return;let btn=$('rouletteSpin');if(btn.disabled)return;btn.disabled=true;let n=Math.floor(Math.random()*37),color=rouletteColor(n)==='#c52e3c'?'red':n===0?'green':'black',idx=rouletteOrder.indexOf(n),step=Math.PI*2/37,target=-Math.PI/2+idx*step+step/2;let start=performance.now(),duration=4200;function frame(now){let t=Math.min(1,(now-start)/duration),ease=1-Math.pow(1-t,4),angle=-Math.PI/2-ease*Math.PI*2*7+(target+Math.PI/2)*ease;let radius=145+Math.sin(t*Math.PI)*20;drawRoulette(angle,radius);if(t<1)requestAnimationFrame(frame);else{drawRoulette(target,145);let tip=$('rt').value,win=tip==='number'?n===Number($('rn').value):tip===color,m=tip==='number'?30:tip==='green'?14:2,p=win?b*m:0;settle(b,p);msg(`Die Kugel landet auf ${n} (${color==='red'?'Rot':color==='black'?'Schwarz':'Grün'}). ${win?'Gewonnen! Auszahlung '+p+' Münzen.':'Leider verloren.'}`,win?'good':'bad');btn.disabled=false}}requestAnimationFrame(frame)}
function card(){let v=Math.ceil(Math.random()*13);return {v,txt:v===1?'A':v===11?'J':v===12?'Q':v===13?'K':String(v),s:['♠','♥','♦','♣'][Math.floor(Math.random()*4)]}}
function val(c){return c.v===1?11:c.v>10?10:c.v}
function handValue(h){let s=h.reduce((a,c)=>a+val(c),0),aces=h.filter(c=>c.v===1).length;while(s>21&&aces-- >0)s-=10;return s}
function cardHTML(c){return `<span class="playing-card ${c.s==='♥'||c.s==='♦'?'red':''}">${c.txt}${c.s}</span>`}
function bj(){blackjack=null;shell(`${betInput()}<div class="cards" id="bjDealer"></div><div class="small">BANK</div><div class="big-result" id="bjInfo">🃏 Blackjack</div><div class="cards" id="bjPlayer"></div><div class="small">DU</div><div class="controls"><button class="primary" id="bjStart" onclick="startBJ()">STARTEN</button><button class="secondary" id="bjHit" onclick="hitBJ()" disabled>KARTE</button><button class="secondary" id="bjStand" onclick="standBJ()" disabled>HALTEN</button></div><div class="message" id="message">Blackjack zahlt 2,5× aus, normaler Sieg 2×.</div>`)}
function startBJ(){let b=bet();if(!b)return;blackjack={b,p:[card(),card()],d:[card(),card()],done:false};$('bjStart').disabled=true;$('bjHit').disabled=true;$('bjStand').disabled=true;showBJ(true);let cards=[...document.querySelectorAll('#bjPlayer .deal-card')];cards.forEach((el,i)=>setTimeout(()=>el.classList.add('flipped'),350+i*300));let dealerCards=[...document.querySelectorAll('#bjDealer .deal-card')];dealerCards[0]?.classList.add('flipped');setTimeout(()=>{if(!blackjack)return;$('bjHit').disabled=false;$('bjStand').disabled=false;if(handValue(blackjack.p)===21)standBJ()},1150)}
function animatedCards(hand,hideSecond=false){return hand.map((c,i)=>{let hidden=hideSecond&&i===1;let red=c.s==='♥'||c.s==='♦';return `<div class="deal-card" style="animation-delay:${i*.2}s">${hidden?'<div class="face back"></div>':`<div class="face front ${red?'red':''}"><div class="card-face-inner"><span class="card-corner">${c.txt}<br>${c.s}</span><span class="card-suit">${c.s}</span></div></div>`}</div>`}).join('')}
function showBJ(deal=false){let x=blackjack;$('bjPlayer').className='card-row';$('bjDealer').className='card-row';$('bjPlayer').innerHTML=animatedCards(x.p);$('bjDealer').innerHTML=animatedCards(x.d,!x.done);$('bjInfo').textContent=`Du: ${handValue(x.p)}${x.done?' · Bank: '+handValue(x.d):''}`}
function hitBJ(){if(!blackjack||blackjack.done)return;blackjack.p.push(card());showBJ();let latest=$('bjPlayer').lastElementChild;if(latest)setTimeout(()=>latest.classList.add('flipped'),80);if(handValue(blackjack.p)>21){blackjack.done=true;settle(blackjack.b,0);$('bjHit').disabled=true;$('bjStand').disabled=true;$('bjStart').disabled=false;showBJ();msg('Überkauft – du hast verloren.','bad')}else showBJ()}
function standBJ(){if(!blackjack||blackjack.done)return;let x=blackjack;let dealerHidden=$('bjDealer')?.lastElementChild;if(dealerHidden)setTimeout(()=>dealerHidden.classList.add('flipped'),80);while(handValue(x.d)<17)x.d.push(card());x.done=true;let p=0,pl=handValue(x.p),dl=handValue(x.d);if(pl>dl||dl>21)p=pl===21&&x.p.length===2?Math.floor(x.b*2.5):x.b*2;else if(pl===dl)p=x.b;let d=settle(x.b,p);$('bjHit').disabled=true;$('bjStand').disabled=true;$('bjStart').disabled=false;showBJ();msg(pl>21?'Überkauft.':p>x.b?'Du gewinnst! Auszahlung '+p+'.':p===x.b?'Unentschieden – Einsatz zurück.':'Die Bank gewinnt.',p>x.b?'good':p===x.b?'':'bad')}
function dice(){shell(`${betInput()}<div class="controls"><label>Vorhersage <select id="diceGuess"><option value="high">4, 5 oder 6</option><option value="low">1, 2 oder 3</option></select></label></div><div class="dice-stage"><div class="dice-cube" id="diceCube">⚀</div></div><div class="big-result" id="diceResult" style="font-size:22px;min-height:30px">Bereit?</div><button class="primary" id="diceBtn" onclick="rollDice()">WÜRFELN</button><div class="message" id="message">Richtiger Tipp: 2× Auszahlung.</div>`)}
function rollDice(){let b=bet();if(!b)return;let btn=$('diceBtn'),cube=$('diceCube');if(btn.disabled)return;btn.disabled=true;cube.classList.remove('rolling');void cube.offsetWidth;cube.classList.add('rolling');let n=1+Math.floor(Math.random()*6),win=$('diceGuess').value===(n>=4?'high':'low'),p=win?b*2:0;$('diceResult').textContent='Der Würfel rollt …';setTimeout(()=>{cube.textContent=['⚀','⚁','⚂','⚃','⚄','⚅'][n-1];$('diceResult').textContent='Ergebnis: '+n;settle(b,p);animateResult(win?'win':'lose');msg(win?`Richtig! Der Würfel zeigt ${n}. Auszahlung ${p}.`:`Leider falsch – es war eine ${n}.`,win?'good':'bad');btn.disabled=false},1260)}
function coin(){shell(`${betInput()}<div class="controls"><label>Dein Tipp <select id="coinGuess"><option value="Kopf">Kopf</option><option value="Zahl">Zahl</option></select></label></div><div class="coin-stage"><div class="coin-disc" id="coinDisc">K</div></div><div class="big-result" id="coinResult" style="font-size:22px;min-height:30px">Bereit zum Wurf</div><button class="primary" id="coinBtn" onclick="flipCoin()">MÜNZE WERFEN</button><div class="message" id="message">Richtiger Tipp: 2× Auszahlung.</div>`)}
function flipCoin(){let b=bet();if(!b)return;let btn=$('coinBtn'),disc=$('coinDisc');if(btn.disabled)return;btn.disabled=true;let r=Math.random()<.5?'Kopf':'Zahl',w=$('coinGuess').value===r,p=w?b*2:0;disc.classList.remove('flipping');void disc.offsetWidth;disc.classList.add('flipping');$('coinResult').textContent='Die Münze fliegt …';setTimeout(()=>{disc.textContent=r==='Kopf'?'K':'Z';disc.style.transform=r==='Kopf'?'rotateY(0deg)':'rotateY(180deg)';$('coinResult').textContent=r;settle(b,p);animateResult(w?'win':'lose');msg(w?`Richtig! ${r} – Auszahlung ${p}.`:`Es ist ${r}.`,w?'good':'bad');btn.disabled=false},1430)}
function hilo(){hiloCard=null;shell(`${betInput()}<div class="big-result" id="hiloCard">🂠</div><div class="controls"><button class="secondary" onclick="guessHilo('high')">NÄCHSTE HÖHER</button><button class="secondary" onclick="guessHilo('low')">NÄCHSTE TIEFER</button><button class="primary" onclick="newHilo()">NEUE RUNDE</button></div><div class="message" id="message">Starte eine Runde. Richtiger Tipp zahlt 2× aus.</div>`)}
function newHilo(){hiloCard=card();$('hiloCard').textContent=hiloCard.txt+hiloCard.s;msg('Karte liegt. Höher oder tiefer?')}
function guessHilo(g){let b=bet();if(!b)return;if(!hiloCard){msg('Erst „Neue Runde“ drücken.','bad');return}let next=card();$('hiloCard').textContent=next.txt+next.s;let win=g==='high'?next.v>hiloCard.v:next.v<hiloCard.v,p=win?b*2:0;settle(b,p);hiloCard=next;msg(win?'Richtig getippt! Auszahlung '+p+'.':'Falsch oder gleiche Karte. Einsatz verloren.',win?'good':'bad')}
function minesGame(){mines=null;shell(`${betInput()}<div class="small">Es gibt 3 versteckte Minen unter 25 Feldern. Jeder sichere Edelstein erhöht deinen möglichen Gewinn. Triffst du eine Mine, verlierst du den Einsatz.</div><div class="grid-mines" id="mineGrid"></div><div class="controls"><button class="primary" onclick="startMines()">NEUES FELD</button><button class="secondary" id="cashMine" onclick="cashMines()" disabled>GEWINN SICHERN</button></div><div class="message" id="message">Einsatz wählen und neues Feld starten.</div>`);drawMines()}
function drawMines(revealAll=false){if(!mines)return;$('mineGrid').innerHTML=mines.cells.map((v,i)=>{let shown=v==='safe'?'💎':v==='mine'?'💣':revealAll&&mines.mineIds.includes(i)?'💣':'?';return `<button class="mine-cell ${v==='safe'?'revealed':v==='mine'?'mine':''}" ${v||mines.done?'disabled':''} onclick="pickMine(${i})">${shown}</button>`}).join('')}
function startMines(){let b=bet();if(!b)return;let ids=[];while(ids.length<3){let n=Math.floor(Math.random()*25);if(!ids.includes(n))ids.push(n)}mines={b,cells:Array(25).fill(null),mineIds:ids,hits:0,done:false};$('cashMine').disabled=true;drawMines();msg('Finde die Edelsteine – aber pass auf die Minen auf!')}
function pickMine(i){if(!mines||mines.done||mines.cells[i]!==null)return;if(mines.mineIds.includes(i)){mines.cells[i]='mine';mines.done=true;settle(mines.b,0);$('cashMine').disabled=true;drawMines(true);animateResult('lose');msg('💥 BOOM! Du hast eine Mine getroffen und deinen Einsatz verloren.','bad')}else{mines.cells[i]='safe';mines.hits++;$('cashMine').disabled=false;drawMines();animateResult('win');let multiplier=(1+mines.hits*.35).toFixed(2);msg(`💎 Sicher! ${mines.hits} Edelstein${mines.hits===1?'':'e'} gefunden. Aktueller möglicher Gewinn: ${Math.floor(mines.b*Number(multiplier))} Münzen (${multiplier}×).`,'good')}}
function cashMines(){if(!mines||mines.done||!mines.hits)return;let mult=1+mines.hits*.35,p=Math.floor(mines.b*mult);mines.done=true;settle(mines.b,p);$('cashMine').disabled=true;drawMines(true);animateResult('win');msg(`🎉 Gewinn gesichert: ${p} Münzen Auszahlung (${mult.toFixed(2)}×).`,'good')}

function wheel(){shell(`${betInput()}<div class="big-result" id="wheelResult">🎯</div><button class="primary" onclick="spinWheel()">RAD DREHEN</button><div class="message" id="message">Mögliche Multiplikatoren: ÷2, 0×, 0,5×, 1×, 2×, 3× oder 5×.</div>`)}
function spinWheel(){
  let b=bet();if(!b)return;
  let m;
  // 90% Chance auf /2 (0.5x Multiplikator), 10% Chance auf normale Optionen
  if(Math.random() < 0.90) {
    m = 0.5;
  } else {
    let opts = [0, 0, 1, 1, 2, 3, 5];
    m = opts[Math.floor(Math.random()*opts.length)];
  }
  
  $('wheelResult').textContent = m === 0.5 ? '÷2' : (m === 0 ? '❌' : m + '×');
  let p = Math.floor(b * m);
  settle(b, p);
  animateResult(p > b ? 'win' : p === 0 ? 'lose' : 'animate');
  msg(m === 0.5 ? `÷2 (Geteilt durch 2) – Auszahlung ${p} Münzen.` : `${m}× – Auszahlung ${p} Münzen.`, p > b ? 'good' : p === b ? '' : 'bad');
}

function baccarat(){shell(`${betInput()}<div class="big-result" id="bacResult">⚔️</div><button class="primary" onclick="playBac()">DUELL STARTEN</button><div class="message" id="message">Ziehe eine Karte für dich und die Bank. Ass = 1, Bildkarten = 0. Auszahlung: 2×.</div>`)}
function playBac(){let b=bet();if(!b)return;let a=card(),d=card(),av=val(a)%10,dv=val(d)%10;$('bacResult').textContent=`${a.txt}${a.s}  ${av}  VS  ${d.txt}${d.s}  ${dv}`;let p=av===dv?b:av>dv?b*2:0;settle(b,p);animateResult(av>dv?'win':av<dv?'lose':'animate');msg(av===dv?'Gleichstand – Einsatz zurück.':av>dv?'Du gewinnst! Auszahlung '+p+'.':'Die Bank gewinnt.',av>dv?'good':av===dv?'':'bad')}
function plinko(){shell(`${betInput()}<p class="plinko-caption">Bei jedem Klick fällt genau eine Kugel. Warte, bis sie unten angekommen ist, und klicke dann erneut für die nächste Runde.</p><div class="table-stage plinko-stage"><canvas id="plinkoCanvas" width="440" height="390"></canvas></div><button class="primary" id="plinkoBtn" onclick="dropPlinko()">KUGEL FALLEN LASSEN</button><div class="message" id="message">Ein Klick = eine Kugel und ein Einsatz.</div>`);drawPlinkoBoard()}
function plinkoMultipliers(){return [4,1.5,.5,.15,0,.15,.5,1.5,4]}
function drawPlinkoBoard(balls=[]){let c=$('plinkoCanvas');if(!c)return;let x=c.getContext('2d'),w=440,h=390;x.clearRect(0,0,w,h);x.fillStyle='#101b2d';x.fillRect(0,0,w,h);let pegs=[];for(let r=0;r<9;r++){let count=r+3,y=48+r*31,start=(w-(count-1)*37)/2;for(let j=0;j<count;j++)pegs.push({x:start+j*37,y})}
let mults=plinkoMultipliers(),bw=w/9;mults.forEach((m,i)=>{x.fillStyle=m===0?'#a63b4a':m>=1.5?'#b18a35':m>=.5?'#236d5a':'#36445c';x.fillRect(i*bw+2,354,bw-4,30);x.fillStyle='white';x.font='bold 13px system-ui';x.textAlign='center';x.fillText(m+'×',i*bw+bw/2,374)});
x.fillStyle='#d9b86a';pegs.forEach(p=>{x.beginPath();x.arc(p.x,p.y,4.5,0,Math.PI*2);x.fill()});x.fillStyle='#d6a545';x.fillRect(215,8,10,15);
balls.forEach(ball=>{x.shadowColor='#ffcc55';x.shadowBlur=10;x.fillStyle=ball.color;x.beginPath();x.arc(ball.x,ball.y,8,0,Math.PI*2);x.fill();x.shadowBlur=0})}
function dropPlinko(){let totalBet=bet();if(!totalBet)return;let btn=$('plinkoBtn');if(btn.disabled)return;btn.disabled=true;let ball={x:220,y:24,vx:(Math.random()-.5)*1.5,vy:0,r:8,color:'#ff5964',done:false,slot:null};let pegs=[];for(let r=0;r<9;r++){let count=r+3,y=48+r*31,start=(440-(count-1)*37)/2;for(let j=0;j<count;j++)pegs.push({x:start+j*37,y})}
let last=performance.now(),elapsed=0;function tick(now){let dt=Math.min((now-last)/16.67,1.8);last=now;elapsed+=dt;if(!ball.done){ball.vy+=.22*dt;ball.x+=ball.vx*dt;ball.y+=ball.vy*dt;if(ball.x<10||ball.x>430){ball.x=Math.max(10,Math.min(430,ball.x));ball.vx*=-.72}for(let peg of pegs){let dx=ball.x-peg.x,dy=ball.y-peg.y,d=Math.hypot(dx,dy),min=ball.r+4.5;if(d<min&&d>0){let nx=dx/d,ny=dy/d;ball.x=peg.x+nx*min;ball.y=peg.y+ny*min;let dot=ball.vx*nx+ball.vy*ny;if(dot<0){ball.vx-=1.55*dot*nx;ball.vy-=1.55*dot*ny}ball.vx+=(Math.random()-.5)*.75}}ball.vx*=.997;if(ball.y>=345||elapsed>1200){ball.done=true;ball.slot=Math.max(0,Math.min(8,Math.floor(ball.x/(440/9))));ball.y=337;ball.x=ball.slot*(440/9)+(440/18)}}drawPlinkoBoard([ball]);if(!ball.done){requestAnimationFrame(tick)}else{let m=plinkoMultipliers()[ball.slot],p=Math.floor(totalBet*m);settle(totalBet,p);drawPlinkoBoard([ball]);animateResult(p>totalBet?'win':p===0?'lose':'animate');msg(`Die Kugel landet bei ${m}×. Auszahlung: ${p} Münzen bei ${totalBet} Einsatz.`,p>totalBet?'good':p===0?'bad':'');btn.disabled=false}}requestAnimationFrame(tick)}
function resetBalance(){if(confirm('Spielstand wirklich auf 1.000 Münzen zurücksetzen?')){balance=1000;rounds=0;net=0;save();selectGame(current)}}
$('gameList').innerHTML=games.map(g=>`<button class="game-btn" data-id="${g.id}" onclick="selectGame('${g.id}')"><span class="game-icon">${g.icon}</span>${g.name}</button>`).join('');
save();selectGame('slots');
</script>
